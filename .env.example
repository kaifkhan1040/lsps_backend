# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,www.lspsgurugram.in,lspsgurugram.in

# React frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.lspsgurugram.in
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.lspsgurugram.in

# Email (used for the admission-popup automailer). Defaults to console
# backend (prints to terminal) until you set real SMTP credentials.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@lspsgurugram.in
